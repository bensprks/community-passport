{
  "name": "community-passport",
  "private": true,
  "version": "0.1.0",
  "description": "One sign-in and one Lens Account across community apps, with scoped, expiring grants per app.",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:contracts": "cd contracts && forge test",
    "chain": "bash scripts/dev-chain.sh",
    "e2e": "pnpm --filter @community-passport/e2e test"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
