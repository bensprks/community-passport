{
  "name": "community-passport",
  "private": true,
  "version": "0.1.0",
  "description": "One sign-in and one Lens Account across community apps, with scoped, expiring grants per app.",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter '!@community-passport/e2e' test",
    "test:contracts": "cd contracts && forge test",
    "chain": "bash scripts/dev-chain.sh",
    "e2e": "pnpm --filter @community-passport/e2e test",
    "dev:setup": "node scripts/dev-setup.mjs",
    "passport": "node --env-file-if-exists=.env apps/passport/src/main.ts",
    "club": "node --env-file-if-exists=.env apps/demo-club/src/main.ts",
    "demo": "node scripts/demo.mjs"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "viem": "2.58.4"
  }
}
