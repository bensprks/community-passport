# The Passport's public URL. Its host is the domain every passkey belongs to, so in production it must never change.
PASSPORT_ISSUER=http://localhost:4000
PASSPORT_PORT=4000

# Pays the gas for creating Accounts and for submitting grants and revocations. It owns nothing.
PASSPORT_RELAYER_KEY=

# Encrypts the development key store. In production a key vendor holds the keys instead.
PASSPORT_KEYSTORE_SECRET=

# The apps that may ask for sign-in. See clubs.example.json.
PASSPORT_CLUBS_FILE=clubs.json

# The chain. These default to the local chain's, which `pnpm chain` writes to .data/local.json.
# PASSPORT_CHAIN_ID=
# PASSPORT_RPC_URL=
# PASSPORT_GRANT_REGISTRY=
# PASSPORT_ACCOUNT_FACTORY=

# Who holds the key to a new member's Account. "vendor" (the default): the key store, until the member takes it
# over. "email": nobody. The Account is owned by a contract rooted in the member's email, and their devices sign.
# PASSPORT_CUSTODY=vendor
# For "email", FOR DEVELOPMENT: the key that vouches a member sent an email, in place of a real proof.
# PASSPORT_EMAIL_ATTESTOR_KEY=

# The contracts a grant may name, comma separated: the Lens feeds and graphs clubs act on. Never a token.
# Defaults to the local chain's global feed and graph and the demo club's own feed.
# PASSPORT_SCOPE_TARGETS=
